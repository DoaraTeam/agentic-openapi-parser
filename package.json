{
  "name": "agentic-openapi-parser",
  "version": "1.0.0",
  "description": "A framework-agnostic TypeScript library for dynamic OpenAPI tool execution",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.mjs",
      "require": "./dist/*/index.js"
    }
  },
  "scripts": {
    "test": "jest",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openapi",
    "agentic",
    "parser",
    "llm",
    "tools",
    "typescript"
  ],
  "author": "Thuy Phuoc Thinh <thuyphuocthinhtpt1@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/DoaraTeam/agentic-openapi-parser.git"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "axios": "^1.18.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.2.0",
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "@nestjs/common": ">=10.0.0",
    "ai": ">=3.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.1",
    "@types/pino": "^7.0.5",
    "ai": "^7.0.19",
    "eslint": "^10.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.5",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "zod": "^4.4.3"
  }
}